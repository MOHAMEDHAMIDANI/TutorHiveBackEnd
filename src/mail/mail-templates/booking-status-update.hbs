<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=">
    <title>{{title}}</title>
</head>

<body style="margin:0;font-family:arial">
    <table style="border:0;width:100%">
        <tr style="background:#eeeeee">
            <td style="padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600">
                {{app_name}}
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#808080;font-size:16px;font-weight:100">
                Hi {{firstName}},<br><br>
                Your appointment scheduled for {{date}} from {{fromTime}} to {{toTime}} has been {{status}}.<br><br>
                {{#if notes}}
                Additional notes: {{notes}}<br><br>
                {{/if}}
                {{#if isBooker}}
                The service provider has {{status}} this appointment.
                {{else}}
                The client has {{status}} this appointment.
                {{/if}}
            </td>
        </tr>
    </table>
</body>

</html>
